{
  "name": "@involvex/create-zed-extension",
  "author": "involvex",
  "version": "0.1.0",
  "description": "Interactive CLI to scaffold Zed editor extensions",
  "type": "module",
  "bin": {
    "create-zed-extension": "./dist/index.js"
  },
  "files": [
    "dist",
    "licenses"
  ],
  "scripts": {
    "check": "bun check",
    "fmt": "bun fmt",
    "lint": "bun lint",
    "prebuild": "bun run fmt && bun run check && bun run lint",
    "build": "bun scripts/build.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun run lint && bun run build"
  },
  "keywords": [
    "zed",
    "extension",
    "scaffold",
    "create",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
